  "description": "UML class diagram shape with three sections for class name, attributes, and methods",
  "icon": "preview.svg",
  "iconSvg": "<rect x=\"2\" y=\"2\" width=\"32\" height=\"32\" fill=\"#fff9c4\" stroke=\"currentColor\" stroke-width=\"1.5\"/><line x1=\"2\" y1=\"12.67\" x2=\"34\" y2=\"12.67\" stroke=\"currentColor\" stroke-width=\"1.5\"/><line x1=\"2\" y1=\"23.33\" x2=\"34\" y2=\"23.33\" stroke=\"currentColor\" stroke-width=\"1.5\"/>",
  "tags": ["uml", "class", "diagram", "oop", "object-oriented"],
  
  "defaultSize": {
    "width": 150,
    "height": 120
  },
  
  "defaultStyle": {
    "fill": "#fff9c4",
    "stroke": "#000000",
    "strokeWidth": 2,
    "opacity": 1,
    "textColor": "#000000"
  },
  
  "ports": {
    "enabled": true,
    "preset": "standard-4",
    "positions": [
      { "id": "top", "x": 0.5, "y": 0, "type": "both", "direction": "top" },
      { "id": "right", "x": 1, "y": 0.5, "type": "both", "direction": "right" },
      { "id": "bottom", "x": 0.5, "y": 1, "type": "both", "direction": "bottom" },
      { "id": "left", "x": 0, "y": 0.5, "type": "both", "direction": "left" }
    ]
  },
  
  "handles": {
    "enabled": true,
    "preset": "all-8",
    "positions": ["n", "ne", "e", "se", "s", "sw", "w", "nw"]

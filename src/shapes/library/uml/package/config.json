{
  "id": "uml-package",
  "name": "Package",
  "type": "package",
  "category": "uml",
  "description": "UML package shape with tab representing a namespace or grouping of related elements",
  "icon": "preview.svg",
  "iconSvg": "<rect x=\"2\" y=\"2\" width=\"12\" height=\"6\" fill=\"#ffccbc\" stroke=\"currentColor\" stroke-width=\"1.5\"/><rect x=\"2\" y=\"8\" width=\"32\" height=\"26\" fill=\"#ffccbc\" stroke=\"currentColor\" stroke-width=\"1.5\"/>",
  "tags": ["uml", "package", "namespace", "folder", "container"],
  
  "defaultSize": {
    "width": 150,
    "height": 100
  },
  
  "defaultStyle": {
    "fill": "#ffccbc",
    "stroke": "#000000",
    "strokeWidth": 2,
    "opacity": 1,
    "textColor": "#000000"
  },
  
  "ports": {
    "enabled": true,
    "preset": "standard-4",
    "positions": [
      { "id": "top", "x": 0.5, "y": 0, "type": "both", "direction": "top" },
      { "id": "right", "x": 1, "y": 0.5, "type": "both", "direction": "right" },
      { "id": "bottom", "x": 0.5, "y": 1, "type": "both", "direction": "bottom" },
      { "id": "left", "x": 0, "y": 0.5, "type": "both", "direction": "left" }
    ]
  },
  
  "handles": {
    "enabled": true,
    "preset": "all-8",
    "positions": ["n", "ne", "e", "se", "s", "sw", "w", "nw"]
  },
  
  "constraints": {
    "minWidth": 100,
    "minHeight": 70,
    "maxWidth": 1000,
    "maxHeight": 1000,
    "aspectRatio": null
  },
  
  "features": {
    "resizable": true,
    "rotatable": false,
    "connectable": true,
    "groupable": true,
    "lockable": true,
    "clonable": true
  },
  
  "metadata": {
    "version": "1.0.0",
    "author": "System",
    "created": "2025-01-01",
    "updated": "2025-01-01"
  }
}
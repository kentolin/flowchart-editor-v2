{
  "id": "uml-interface",
  "name": "Interface",
  "type": "interface",
  "category": "uml",
  "description": "UML interface shape with circle symbol and stereotype label representing a contract or API",
  "icon": "preview.svg",
  "iconSvg": "<circle cx=\"18\" cy=\"8\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><rect x=\"6\" y=\"16\" width=\"24\" height=\"16\" fill=\"#e1bee7\" stroke=\"currentColor\" stroke-width=\"1.5\"/>",
  "tags": ["uml", "interface", "contract", "api", "abstract"],
  
  "defaultSize": {
    "width": 130,
    "height": 110
  },
  
  "defaultStyle": {
    "fill": "#e1bee7",
    "stroke": "#000000",
    "strokeWidth": 2,
    "opacity": 1,
    "textColor": "#000000"
  },
  
  "ports": {
    "enabled": true,
    "preset": "standard-4",
    "positions": [
      { "id": "top", "x": 0.5, "y": 0, "type": "both", "direction": "top" },
      { "id": "right", "x": 1, "y": 0.5, "type": "both", "direction": "right" },
      { "id": "bottom", "x": 0.5, "y": 1, "type": "both", "direction": "bottom" },
      { "id": "left", "x": 0, "y": 0.5, "type": "both", "direction": "left" }
    ]
  },
  
  "handles": {
    "enabled": true,
    "preset": "all-8",
    "positions": ["n", "ne", "e", "se", "s", "sw", "w", "nw"]
  },
  
  "constraints": {
    "minWidth": 100,
    "minHeight": 90,
    "maxWidth": 1000,
    "maxHeight": 1000,
    "aspectRatio": null
  },
  
  "features": {
    "resizable": true,
    "rotatable": false,
    "connectable": true,
    "groupable": true,
    "lockable": true,
    "clonable": true
  },
  
  "metadata": {
    "version": "1.0.0",
    "author": "System",
    "created": "2025-01-01",
    "updated": "2025-01-01"
  }
}
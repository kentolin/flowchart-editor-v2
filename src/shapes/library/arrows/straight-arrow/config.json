  "icon": "preview.svg",
  "iconSvg": "<line x1=\"2\" y1=\"18\" x2=\"30\" y2=\"18\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M 26 14 L 34 18 L 26 22\" fill=\"currentColor\"/>",

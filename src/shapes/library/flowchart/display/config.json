{
  "id": "flowchart-display",
  "name": "Display",
  "type": "display",
  "category": "flowchart",
  "description": "Display or output shape with curved sides for showing results or output operations",
  "icon": "preview.svg",
  "iconSvg": "<path d=\"M 3 6 L 33 6 Q 36 6 36 18 Q 36 30 33 30 L 3 30 Q 0 30 0 18 Q 0 6 3 6 Z\"/>",
  "tags": ["flowchart", "display", "output", "result", "show"],
  
  "defaultSize": {
    "width": 120,
    "height": 80
  },
  
  "defaultStyle": {
    "fill": "#ffffff",
    "stroke": "#000000",
    "strokeWidth": 2,
    "opacity": 1,
    "textColor": "#000000"
  },
  
  "ports": {
    "enabled": true,
    "preset": "standard-4",
    "positions": [
      { "id": "top", "x": 0.5, "y": 0, "type": "input", "direction": "top" },
      { "id": "right", "x": 1, "y": 0.5, "type": "output", "direction": "right" },
      { "id": "bottom", "x": 0.5, "y": 1, "type": "output", "direction": "bottom" },
      { "id": "left", "x": 0, "y": 0.5, "type": "input", "direction": "left" }
    ]
  },
  
  "handles": {
    "enabled": true,
    "preset": "all-8",
    "positions": ["n", "ne", "e", "se", "s", "sw", "w", "nw"]
  },
  
  "constraints": {
    "minWidth": 80,
    "minHeight": 50,
    "maxWidth": 1000,
    "maxHeight": 1000,
    "aspectRatio": null
  },
  
  "features": {
    "resizable": true,
    "rotatable": false,
    "connectable": true,
    "groupable": true,
    "lockable": true,
    "clonable": true
  },
  
  "metadata": {
    "version": "1.0.0",
    "author": "System",
    "created": "2025-01-01",
    "updated": "2025-01-01"
  }
}